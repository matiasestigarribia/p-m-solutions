# ─── Identity ─────────────────────────────────────────────────────────────────
PM_PROJECT_NAME="P & M Solutions"
PM_ENVIRONMENT=development           # development | staging | production

# ─── Security (CSRF + admin JWT) ──────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PM_SECRET_KEY=dev-insecure-change-me
# Separate JWT key for admin sessions (required in production; minimum 32 chars)
# PM_ADMIN_SECRET_KEY=another-strong-key-here
PM_ADMIN_JWT_EXPIRATION_MINUTES=60

# ─── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Enable to activate DB persistence (required in production)
PM_ENABLE_DATABASE=false
# Neon asyncpg URL — obtain from Neon dashboard → Connection string → asyncpg
# Format: postgresql+asyncpg://USER:PASSWORD@ep-your-branch.region.aws.neon.tech/neondb?ssl=require
# PM_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?ssl=require

# ─── Object Storage (Cloudflare R2) ───────────────────────────────────────────
PM_ENABLE_OBJECT_STORAGE=false
# All six vars required when PM_ENABLE_OBJECT_STORAGE=true
# PM_R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# PM_R2_ACCESS_KEY=your-r2-access-key-id
# PM_R2_SECRET_KEY=your-r2-secret-access-key
# PM_R2_BUCKET_NAME=pm-solutions-media
# PM_R2_PRIVATE_BUCKET_NAME=pm-solutions-private
# PM_R2_PUBLIC_URL=https://assets.yourdomain.com

# ─── Chatbot (absent from MVP) ────────────────────────────────────────────────
PM_ENABLE_CHATBOT=false

# ─── Dev contact sink (used only when PM_ENABLE_DATABASE=false) ───────────────
PM_CONTACT_SINK=sqlite
PM_CONTACT_DB_PATH=./data/contact.sqlite3
PM_CONTACT_RATE_LIMIT_PER_HOUR=20
